{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dispatcher.local/schema/project-manager/v1/project_manager.schema.json",
  "title": "Dispatcher Project Manager v1 payload definitions",
  "type": "object",
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "createProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "emptyRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "projectIdRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "updateProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "projectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project"],
      "properties": {
        "project": { "$ref": "#/$defs/project" }
      }
    },
    "projectListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects"],
      "properties": {
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/project" }
        }
      }
    }
  }
}
