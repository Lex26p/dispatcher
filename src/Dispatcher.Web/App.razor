@implements IDisposable
@inject AuthenticationClient Authentication

@if (!_authenticationReady)
{
    <div class="application-shell authentication-shell">
        <header class="global-header authentication-header">
            <div class="brand">Dispatcher</div>
            <div class="global-section">Аутентификация</div>
        </header>
        <div class="application-content authentication-workspace">
            <div class="authentication-status">
                Проверка текущей сессии…
            </div>
        </div>
    </div>
}
else if (!Authentication.CurrentUser.Authenticated)
{
    <Login />
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            @if (CanAccessRoute(
                    routeData.PageType))
            {
                <RouteView RouteData="@routeData"
                           DefaultLayout="@typeof(MainLayout)" />
            }
            else
            {
                <LayoutView Layout="@typeof(MainLayout)">
                    <div class="not-found">
                        Недостаточно прав для этого раздела.
                        Требуется:
                        <span>@MissingPermissions(routeData.PageType)</span>.
                    </div>
                </LayoutView>
            }
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="not-found">
                    Страница не найдена.
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool _authenticationReady;

    private bool CanAccessRoute(
        Type pageType)
    {
        if (pageType == typeof(SecurityAdmin))
        {
            return Authentication.HasPermission(
                    PermissionNames.UsersManage)
                || Authentication.HasPermission(
                    PermissionNames.RolesManage);
        }

        return RequiredPermissions(
                pageType)
            .All(
                Authentication.HasPermission);
    }

    private string MissingPermissions(
        Type pageType)
    {
        if (pageType == typeof(SecurityAdmin))
        {
            return $"{PermissionNames.UsersManage} или {PermissionNames.RolesManage}";
        }

        return string.Join(
            ", ",
            RequiredPermissions(
                    pageType)
                .Where(permission =>
                    !Authentication.HasPermission(
                        permission)));
    }

    private static IReadOnlyList<string> RequiredPermissions(
        Type pageType)
    {
        if (pageType == typeof(DeviceEditor))
        {
            return
            [
                PermissionNames.RuntimeRead,
                PermissionNames.DevicesEdit
            ];
        }

        if (pageType == typeof(MimicEditor))
        {
            return
            [
                PermissionNames.RuntimeRead,
                PermissionNames.MimicsEdit
            ];
        }

        if (pageType == typeof(AlarmEditor))
        {
            return
            [
                PermissionNames.RuntimeRead,
                PermissionNames.AlarmsConfigure
            ];
        }

        return
        [
            PermissionNames.RuntimeRead
        ];
    }

    protected override async Task OnInitializedAsync()
    {
        Authentication.Changed += OnAuthenticationChanged;

        await Authentication.InitializeAsync();

        _authenticationReady =
            true;
    }

    private void OnAuthenticationChanged()
    {
        _authenticationReady =
            Authentication.IsInitialized;

        _ = InvokeAsync(
            StateHasChanged);
    }

    public void Dispose()
    {
        Authentication.Changed -= OnAuthenticationChanged;
    }
}
