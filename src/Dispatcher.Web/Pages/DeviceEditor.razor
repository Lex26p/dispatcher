@page "/devices"
@inject ConfigurationClient Configuration
@inject IJSRuntime JavaScript

<PageTitle>Dispatcher — Редактор устройств</PageTitle>

<div class="device-editor-shell">
    <aside class="editor-local-navigation">
        <div class="editor-panel-heading">
            <span>Устройства</span>
            <span class="item-count">@_devices.Count</span>
        </div>

        <div class="editor-tree">
            @if (_loading)
            {
                <div class="compact-empty">Загрузка…</div>
            }
            else if (_devices.Count == 0)
            {
                <div class="compact-empty">
                    Устройств пока нет.
                </div>
            }
            else
            {
                @foreach (var device in _devices)
                {
                    <button type="button"
                            class="editor-tree-device @DeviceSelectionClass(device)"
                            @onclick="() => SelectDeviceAsync(device)">
                        <span class="config-enabled-dot @(device.Enabled ? "enabled" : "disabled")"
                              title="@(device.Enabled ? "Enabled" : "Disabled")"
                              aria-hidden="true"></span>

                        <span class="editor-tree-main">
                            <span class="editor-tree-name-row">
                                <span class="editor-tree-name">@device.Name</span>
                                <span class="protocol-badge">@device.ProtocolShortLabel</span>
                            </span>
                            <span class="editor-tree-id">@device.DeviceId</span>
                        </span>

                        <span class="editor-tree-count">@device.Tags.Count</span>
                    </button>

                    <div class="editor-tree-tags">
                        @foreach (var tag in device.Tags)
                        {
                            <button type="button"
                                    class="editor-tree-tag @TagSelectionClass(device, tag)"
                                    @onclick="() => SelectTagAsync(device, tag)">
                                <span class="tree-branch" aria-hidden="true">└</span>
                                <span class="editor-tree-main">
                                    <span class="editor-tree-name">@tag.Name</span>
                                    <span class="editor-tree-id">@tag.TagId</span>
                                </span>
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </aside>

    <main class="editor-workspace">
        <div class="editor-toolbar">
            <div class="editor-toolbar-left">
                <button type="button"
                        class="toolbar-button"
                        disabled="@_busy"
                        @onclick="CreateDeviceAsync">
                    + Устройство
                </button>

                <button type="button"
                        class="toolbar-button"
                        disabled="@(!CanCreateTag || _busy)"
                        @onclick="CreateTagAsync">
                    + Тег
                </button>

                <span class="editor-toolbar-divider"></span>

                <button type="button"
                        class="toolbar-button primary"
                        disabled="@(!CanSave || _busy)"
                        @onclick="SaveAsync">
                    @(_busy ? "Сохранение…" : "Сохранить")
                </button>

                <button type="button"
                        class="toolbar-button danger"
                        disabled="@(!CanDelete || _busy)"
                        @onclick="DeleteAsync">
                    @DeleteButtonText
                </button>
            </div>

            <div class="editor-toolbar-right">
                @if (_dirty)
                {
                    <span class="unsaved-indicator">
                        несохранено
                    </span>
                }

                <button type="button"
                        class="toolbar-button"
                        disabled="@_busy"
                        @onclick="RefreshAsync">
                    Обновить
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="editor-error">
                @_error
            </div>
        }

        <div class="editor-work-content">
            @if (_selectionKind == SelectionKind.None)
            {
                <div class="editor-empty-state">
                    <div class="editor-empty-title">
                        Выберите устройство
                    </div>
                    <div class="editor-empty-text">
                        Или создайте новое Modbus TCP / SNMP v2c устройство через toolbar.
                    </div>
                </div>
            }
            else if (_selectionKind == SelectionKind.Device
                     && _isNewDevice)
            {
                <div class="editor-empty-state">
                    <div class="editor-empty-title">
                        Новое устройство
                    </div>
                    <div class="editor-empty-text">
                        Выберите протокол и заполните свойства справа.
                        После сохранения можно добавить теги.
                    </div>
                </div>
            }
            else if (SelectedDevice is not null)
            {
                <div class="editor-device-summary">
                    <div>
                        <div class="editor-work-title-row">
                            <div class="editor-work-title">
                                @SelectedDevice.Name
                            </div>
                            <span class="protocol-badge strong">
                                @SelectedDevice.ProtocolLabel
                            </span>
                        </div>
                        <div class="editor-work-subtitle">
                            @SelectedDevice.DeviceId · @DeviceConnectionSummary(SelectedDevice)
                        </div>
                    </div>

                    <span class="editor-device-enabled @(SelectedDevice.Enabled ? "enabled" : "disabled")">
                        @(SelectedDevice.Enabled ? "Enabled" : "Disabled")
                    </span>
                </div>

                <div class="editor-table-area">
                    <table class="editor-data-table">
                        <thead>
                            <tr>
                                <th>Tag ID</th>
                                <th>Имя</th>
                                <th>Тип</th>
                                <th>Address / OID</th>
                                <th>Write</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (SelectedDevice.Tags.Count == 0)
                            {
                                <tr>
                                    <td colspan="5"
                                        class="table-empty">
                                        У устройства пока нет тегов.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var tag in SelectedDevice.Tags)
                                {
                                    <tr class="@TagRowClass(tag)"
                                        @onclick="() => SelectTagAsync(SelectedDevice, tag)">
                                        <td class="tag-id">@tag.TagId</td>
                                        <td>@tag.Name</td>
                                        <td>@tag.TypeLabel</td>
                                        <td class="address-cell"
                                            title="@tag.AddressLabel">
                                            @tag.AddressLabel
                                        </td>
                                        <td>
                                            @(tag.Writable ? "Да" : "Нет")
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>

    <aside class="editor-properties">
        <div class="editor-panel-heading">
            @PropertiesHeading
        </div>

        @if (_selectionKind == SelectionKind.None)
        {
            <div class="editor-properties-empty">
                Выберите устройство или тег.
            </div>
        }
        else if (_selectionKind == SelectionKind.Device)
        {
            <div class="property-form">
                <label class="property-field">
                    <span>Protocol</span>
                    <select @bind="_deviceDraft.Protocol"
                            @bind:after="OnProtocolChanged"
                            disabled="@(!_isNewDevice)">
                        <option value="ModbusTcp">Modbus TCP</option>
                        <option value="SnmpV2c">SNMP v2c</option>
                    </select>
                </label>

                @if (!_isNewDevice)
                {
                    <div class="property-inline-note">
                        Протокол существующего устройства не меняется.
                    </div>
                }

                <label class="property-field">
                    <span>Device ID</span>
                    <input type="text"
                           @bind="_deviceDraft.DeviceId"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>

                <label class="property-field">
                    <span>Имя</span>
                    <input type="text"
                           @bind="_deviceDraft.Name"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>

                <label class="property-checkbox">
                    <input type="checkbox"
                           @bind="_deviceDraft.Enabled"
                           @bind:after="MarkDirty" />
                    <span>Устройство включено</span>
                </label>

                <div class="property-section-title">
                    @ProtocolSectionTitle(_deviceDraft.Protocol)
                </div>

                <label class="property-field">
                    <span>Host</span>
                    <input type="text"
                           @bind="_deviceDraft.Host"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>

                @if (_deviceDraft.Protocol == DeviceProtocol.ModbusTcp)
                {
                    <div class="property-grid-two">
                        <label class="property-field">
                            <span>Port</span>
                            <input type="number"
                                   min="1"
                                   max="65535"
                                   @bind="_deviceDraft.Port"
                                   @bind:after="MarkDirty" />
                        </label>

                        <label class="property-field">
                            <span>Unit ID</span>
                            <input type="number"
                                   min="0"
                                   max="255"
                                   @bind="_deviceDraft.UnitId"
                                   @bind:after="MarkDirty" />
                        </label>
                    </div>
                }
                else
                {
                    <label class="property-field">
                        <span>UDP Port</span>
                        <input type="number"
                               min="1"
                               max="65535"
                               @bind="_deviceDraft.Port"
                               @bind:after="MarkDirty" />
                    </label>

                    <label class="property-field">
                        <span>Community</span>
                        <input type="text"
                               autocomplete="off"
                               @bind="_deviceDraft.Community"
                               @bind:event="oninput"
                               @bind:after="MarkDirty" />
                    </label>
                }

                <div class="property-section-title">Polling</div>

                <label class="property-field">
                    <span>Интервал, мс</span>
                    <input type="number"
                           min="1"
                           @bind="_deviceDraft.PollIntervalMilliseconds"
                           @bind:after="MarkDirty" />
                </label>

                <label class="property-field">
                    <span>Timeout, мс</span>
                    <input type="number"
                           min="1"
                           @bind="_deviceDraft.RequestTimeoutMilliseconds"
                           @bind:after="MarkDirty" />
                </label>
            </div>
        }
        else
        {
            <div class="property-form">
                <label class="property-field">
                    <span>Tag ID</span>
                    <input type="text"
                           @bind="_tagDraft.TagId"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>

                <label class="property-field">
                    <span>Имя</span>
                    <input type="text"
                           @bind="_tagDraft.Name"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>

                @if (_tagDraft.Protocol == DeviceProtocol.ModbusTcp)
                {
                    <div class="property-section-title">Modbus TCP</div>

                    <label class="property-field">
                        <span>Area / type</span>
                        <input type="text"
                               value="Holding Register / UInt16"
                               disabled />
                    </label>

                    <label class="property-field">
                        <span>Raw address</span>
                        <input type="number"
                               min="0"
                               max="65535"
                               @bind="_tagDraft.Address"
                               @bind:after="MarkDirty" />
                    </label>

                    <label class="property-checkbox">
                        <input type="checkbox"
                               @bind="_tagDraft.Writable"
                               @bind:after="MarkDirty" />
                        <span>Разрешить запись FC06</span>
                    </label>

                    <div class="property-help">
                        Address — raw 0-based protocol address,
                        передаваемый в Modbus-запрос.
                    </div>
                }
                else
                {
                    <div class="property-section-title">SNMP v2c GET</div>

                    <label class="property-field">
                        <span>OID</span>
                        <input type="text"
                               class="monospace-input"
                               placeholder="1.3.6.1.2.1.1.5.0"
                               @bind="_tagDraft.Oid"
                               @bind:event="oninput"
                               @bind:after="MarkDirty" />
                    </label>

                    <label class="property-field">
                        <span>Runtime value</span>
                        <input type="text"
                               value="SMI value → CLR value"
                               disabled />
                    </label>

                    <div class="property-help">
                        SNMP-теги S10 являются read-only и опрашиваются через GET.
                        OID задаётся в числовой dotted-форме.
                    </div>
                }
            </div>
        }
    </aside>
</div>

@code {
    private IReadOnlyList<DeviceItem> _devices =
        Array.Empty<DeviceItem>();

    private SelectionKind _selectionKind;
    private DeviceProtocol? _selectedProtocol;
    private string? _selectedDeviceId;
    private string? _selectedTagId;

    private DeviceDraft _deviceDraft = new();
    private TagDraft _tagDraft = new();

    private bool _isNewDevice;
    private bool _isNewTag;
    private bool _dirty;
    private bool _loading;
    private bool _busy;
    private string? _error;

    private DeviceItem? SelectedDevice =>
        _selectedProtocol is null
        || _selectedDeviceId is null
            ? null
            : _devices.FirstOrDefault(device =>
                device.Protocol == _selectedProtocol.Value
                && string.Equals(
                    device.DeviceId,
                    _selectedDeviceId,
                    StringComparison.Ordinal));

    private bool CanCreateTag =>
        SelectedDevice is not null
        && !_isNewDevice;

    private bool CanSave =>
        _selectionKind != SelectionKind.None;

    private bool CanDelete =>
        _selectionKind != SelectionKind.None;

    private string DeleteButtonText =>
        _isNewDevice || _isNewTag
            ? "Отменить"
            : "Удалить";

    private string PropertiesHeading =>
        _selectionKind switch
        {
            SelectionKind.Device =>
                _isNewDevice
                    ? "Новое устройство"
                    : "Свойства устройства",
            SelectionKind.Tag =>
                _isNewTag
                    ? "Новый тег"
                    : "Свойства тега",
            _ => "Свойства"
        };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task CreateDeviceAsync()
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }

        _selectionKind = SelectionKind.Device;
        _selectedProtocol = null;
        _selectedDeviceId = null;
        _selectedTagId = null;
        _isNewDevice = true;
        _isNewTag = false;
        _deviceDraft = DeviceDraft.CreateDefault(
            DeviceProtocol.ModbusTcp);
        _dirty = true;
        _error = null;
    }

    private async Task CreateTagAsync()
    {
        var device = SelectedDevice;

        if (device is null
            || !await ConfirmDiscardAsync())
        {
            return;
        }

        _selectionKind = SelectionKind.Tag;
        _selectedProtocol = device.Protocol;
        _selectedTagId = null;
        _isNewDevice = false;
        _isNewTag = true;
        _tagDraft = new TagDraft
        {
            Protocol = device.Protocol
        };
        _dirty = true;
        _error = null;
    }

    private async Task SelectDeviceAsync(
        DeviceItem device)
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }

        ApplyDeviceSelection(
            device);
    }

    private async Task SelectTagAsync(
        DeviceItem device,
        TagItem tag)
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }

        ApplyTagSelection(
            device,
            tag);
    }

    private void ApplyDeviceSelection(
        DeviceItem device)
    {
        _selectionKind = SelectionKind.Device;
        _selectedProtocol = device.Protocol;
        _selectedDeviceId = device.DeviceId;
        _selectedTagId = null;
        _isNewDevice = false;
        _isNewTag = false;
        _deviceDraft = DeviceDraft.From(
            device);
        _dirty = false;
        _error = null;
    }

    private void ApplyTagSelection(
        DeviceItem device,
        TagItem tag)
    {
        _selectionKind = SelectionKind.Tag;
        _selectedProtocol = device.Protocol;
        _selectedDeviceId = device.DeviceId;
        _selectedTagId = tag.TagId;
        _isNewDevice = false;
        _isNewTag = false;
        _tagDraft = TagDraft.From(
            tag);
        _dirty = false;
        _error = null;
    }

    private async Task SaveAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            if (_selectionKind == SelectionKind.Device)
            {
                await SaveDeviceAsync();
            }
            else if (_selectionKind == SelectionKind.Tag)
            {
                await SaveTagAsync();
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveDeviceAsync()
    {
        if (_deviceDraft.Protocol == DeviceProtocol.ModbusTcp)
        {
            var request =
                new ModbusDeviceUpsertRequest(
                    _deviceDraft.DeviceId,
                    _deviceDraft.Name,
                    _deviceDraft.Enabled,
                    _deviceDraft.Host,
                    _deviceDraft.Port,
                    _deviceDraft.UnitId,
                    _deviceDraft.PollIntervalMilliseconds,
                    _deviceDraft.RequestTimeoutMilliseconds);

            ModbusDeviceConfigurationDto saved;

            if (_isNewDevice)
            {
                saved =
                    await Configuration.CreateDeviceAsync(
                        request);
            }
            else
            {
                saved =
                    await Configuration.UpdateDeviceAsync(
                        _selectedDeviceId!,
                        request);
            }

            _dirty = false;
            _isNewDevice = false;

            await ReloadAsync(
                DeviceProtocol.ModbusTcp,
                saved.DeviceId,
                tagId: null);

            return;
        }

        var snmpRequest =
            new SnmpDeviceUpsertRequest(
                _deviceDraft.DeviceId,
                _deviceDraft.Name,
                _deviceDraft.Enabled,
                _deviceDraft.Host,
                _deviceDraft.Port,
                _deviceDraft.Community,
                _deviceDraft.PollIntervalMilliseconds,
                _deviceDraft.RequestTimeoutMilliseconds);

        SnmpDeviceConfigurationDto savedSnmp;

        if (_isNewDevice)
        {
            savedSnmp =
                await Configuration.CreateSnmpDeviceAsync(
                    snmpRequest);
        }
        else
        {
            savedSnmp =
                await Configuration.UpdateSnmpDeviceAsync(
                    _selectedDeviceId!,
                    snmpRequest);
        }

        _dirty = false;
        _isNewDevice = false;

        await ReloadAsync(
            DeviceProtocol.SnmpV2c,
            savedSnmp.DeviceId,
            tagId: null);
    }

    private async Task SaveTagAsync()
    {
        var device = SelectedDevice;

        if (device is null)
        {
            throw new InvalidOperationException(
                "Сначала выберите сохранённое устройство.");
        }

        if (device.Protocol == DeviceProtocol.ModbusTcp)
        {
            var request =
                new ModbusTagUpsertRequest(
                    _tagDraft.TagId,
                    _tagDraft.Name,
                    _tagDraft.Address,
                    _tagDraft.Writable);

            ModbusTagConfigurationDto saved;

            if (_isNewTag)
            {
                saved =
                    await Configuration.CreateTagAsync(
                        device.DeviceId,
                        request);
            }
            else
            {
                saved =
                    await Configuration.UpdateTagAsync(
                        device.DeviceId,
                        _selectedTagId!,
                        request);
            }

            _dirty = false;
            _isNewTag = false;

            await ReloadAsync(
                device.Protocol,
                device.DeviceId,
                saved.TagId);

            return;
        }

        var snmpRequest =
            new SnmpTagUpsertRequest(
                _tagDraft.TagId,
                _tagDraft.Name,
                _tagDraft.Oid);

        SnmpTagConfigurationDto savedSnmp;

        if (_isNewTag)
        {
            savedSnmp =
                await Configuration.CreateSnmpTagAsync(
                    device.DeviceId,
                    snmpRequest);
        }
        else
        {
            savedSnmp =
                await Configuration.UpdateSnmpTagAsync(
                    device.DeviceId,
                    _selectedTagId!,
                    snmpRequest);
        }

        _dirty = false;
        _isNewTag = false;

        await ReloadAsync(
            device.Protocol,
            device.DeviceId,
            savedSnmp.TagId);
    }

    private async Task DeleteAsync()
    {
        if (_isNewDevice || _isNewTag)
        {
            CancelNewObject();
            return;
        }

        if (_selectionKind == SelectionKind.None
            || _selectedProtocol is null)
        {
            return;
        }

        var description =
            _selectionKind == SelectionKind.Device
                ? $"устройство '{_selectedDeviceId}' и все его теги"
                : $"тег '{_selectedTagId}'";

        var confirmed =
            await JavaScript.InvokeAsync<bool>(
                "confirm",
                $"Удалить {description}?");

        if (!confirmed)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            if (_selectionKind == SelectionKind.Device)
            {
                if (_selectedProtocol == DeviceProtocol.ModbusTcp)
                {
                    await Configuration.DeleteDeviceAsync(
                        _selectedDeviceId!);
                }
                else
                {
                    await Configuration.DeleteSnmpDeviceAsync(
                        _selectedDeviceId!);
                }
            }
            else if (_selectedProtocol == DeviceProtocol.ModbusTcp)
            {
                await Configuration.DeleteTagAsync(
                    _selectedDeviceId!,
                    _selectedTagId!);
            }
            else
            {
                await Configuration.DeleteSnmpTagAsync(
                    _selectedDeviceId!,
                    _selectedTagId!);
            }

            ClearSelection();
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }

        await ReloadAsync(
            _selectedProtocol,
            _selectedDeviceId,
            _selectedTagId);
    }

    private async Task ReloadAsync(
        DeviceProtocol? protocol = null,
        string? deviceId = null,
        string? tagId = null)
    {
        _loading = true;
        _error = null;

        try
        {
            var modbusDevices =
                await Configuration.GetDevicesAsync();

            var snmpDevices =
                await Configuration.GetSnmpDevicesAsync();

            _devices =
                modbusDevices
                    .Select(device =>
                        DeviceItem.From(device))
                    .Concat(
                        snmpDevices.Select(device =>
                            DeviceItem.From(device)))
                    .OrderBy(
                        device => device.DeviceId,
                        StringComparer.Ordinal)
                    .ToArray();

            if (protocol is null
                || deviceId is null)
            {
                if (_selectionKind != SelectionKind.None)
                {
                    ClearSelection();
                }

                return;
            }

            var device =
                _devices.FirstOrDefault(candidate =>
                    candidate.Protocol == protocol.Value
                    && string.Equals(
                        candidate.DeviceId,
                        deviceId,
                        StringComparison.Ordinal));

            if (device is null)
            {
                ClearSelection();
                return;
            }

            if (tagId is null)
            {
                ApplyDeviceSelection(
                    device);
                return;
            }

            var tag =
                device.Tags.FirstOrDefault(candidate =>
                    string.Equals(
                        candidate.TagId,
                        tagId,
                        StringComparison.Ordinal));

            if (tag is null)
            {
                ApplyDeviceSelection(
                    device);
                return;
            }

            ApplyTagSelection(
                device,
                tag);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void CancelNewObject()
    {
        if (_isNewTag
            && SelectedDevice is not null)
        {
            ApplyDeviceSelection(
                SelectedDevice);
            return;
        }

        ClearSelection();
    }

    private void ClearSelection()
    {
        _selectionKind = SelectionKind.None;
        _selectedProtocol = null;
        _selectedDeviceId = null;
        _selectedTagId = null;
        _isNewDevice = false;
        _isNewTag = false;
        _dirty = false;
        _deviceDraft = new DeviceDraft();
        _tagDraft = new TagDraft();
    }

    private async Task<bool> ConfirmDiscardAsync()
    {
        if (!_dirty)
        {
            return true;
        }

        return await JavaScript.InvokeAsync<bool>(
            "confirm",
            "Есть несохранённые изменения. Отбросить их?");
    }

    private void MarkDirty()
    {
        _dirty = true;
        _error = null;
    }

    private void OnProtocolChanged()
    {
        if (_isNewDevice)
        {
            if (_deviceDraft.Protocol == DeviceProtocol.ModbusTcp)
            {
                _deviceDraft.Port = 502;
                _deviceDraft.UnitId = 1;
            }
            else
            {
                _deviceDraft.Port = 161;
                _deviceDraft.Community = "public";
            }
        }

        MarkDirty();
    }

    private static string ProtocolSectionTitle(
        DeviceProtocol protocol)
    {
        return protocol == DeviceProtocol.ModbusTcp
            ? "Modbus TCP"
            : "SNMP v2c";
    }

    private static string DeviceConnectionSummary(
        DeviceItem device)
    {
        return device.Protocol == DeviceProtocol.ModbusTcp
            ? $"{device.Host}:{device.Port} · Unit {device.Modbus!.UnitId}"
            : $"{device.Host}:{device.Port} · SNMP v2c";
    }

    private string DeviceSelectionClass(
        DeviceItem device)
    {
        return _selectionKind == SelectionKind.Device
               && !_isNewDevice
               && _selectedProtocol == device.Protocol
               && string.Equals(
                   device.DeviceId,
                   _selectedDeviceId,
                   StringComparison.Ordinal)
            ? "selected"
            : string.Empty;
    }

    private string TagSelectionClass(
        DeviceItem device,
        TagItem tag)
    {
        return _selectionKind == SelectionKind.Tag
               && _selectedProtocol == device.Protocol
               && string.Equals(
                   device.DeviceId,
                   _selectedDeviceId,
                   StringComparison.Ordinal)
               && string.Equals(
                   tag.TagId,
                   _selectedTagId,
                   StringComparison.Ordinal)
            ? "selected"
            : string.Empty;
    }

    private string TagRowClass(
        TagItem tag)
    {
        return _selectionKind == SelectionKind.Tag
               && string.Equals(
                   tag.TagId,
                   _selectedTagId,
                   StringComparison.Ordinal)
            ? "selected"
            : string.Empty;
    }

    private enum SelectionKind
    {
        None,
        Device,
        Tag
    }

    private enum DeviceProtocol
    {
        ModbusTcp,
        SnmpV2c
    }

    private sealed class DeviceDraft
    {
        public DeviceProtocol Protocol { get; set; } =
            DeviceProtocol.ModbusTcp;
        public string DeviceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public bool Enabled { get; set; }
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 502;
        public int UnitId { get; set; } = 1;
        public string Community { get; set; } = "public";
        public int PollIntervalMilliseconds { get; set; } = 1000;
        public int RequestTimeoutMilliseconds { get; set; } = 1000;

        public static DeviceDraft CreateDefault(
            DeviceProtocol protocol)
        {
            return new DeviceDraft
            {
                Protocol = protocol,
                Host = "127.0.0.1",
                Port = protocol == DeviceProtocol.ModbusTcp
                    ? 502
                    : 161,
                UnitId = 1,
                Community = "public",
                PollIntervalMilliseconds = 1000,
                RequestTimeoutMilliseconds = 1000
            };
        }

        public static DeviceDraft From(
            DeviceItem device)
        {
            if (device.Protocol == DeviceProtocol.ModbusTcp)
            {
                var source =
                    device.Modbus!;

                return new DeviceDraft
                {
                    Protocol = DeviceProtocol.ModbusTcp,
                    DeviceId = source.DeviceId,
                    Name = source.Name,
                    Enabled = source.Enabled,
                    Host = source.Host,
                    Port = source.Port,
                    UnitId = source.UnitId,
                    Community = "public",
                    PollIntervalMilliseconds =
                        source.PollIntervalMilliseconds,
                    RequestTimeoutMilliseconds =
                        source.RequestTimeoutMilliseconds
                };
            }

            var snmp =
                device.Snmp!;

            return new DeviceDraft
            {
                Protocol = DeviceProtocol.SnmpV2c,
                DeviceId = snmp.DeviceId,
                Name = snmp.Name,
                Enabled = snmp.Enabled,
                Host = snmp.Host,
                Port = snmp.Port,
                UnitId = 1,
                Community = snmp.Community,
                PollIntervalMilliseconds =
                    snmp.PollIntervalMilliseconds,
                RequestTimeoutMilliseconds =
                    snmp.RequestTimeoutMilliseconds
            };
        }
    }

    private sealed class TagDraft
    {
        public DeviceProtocol Protocol { get; set; } =
            DeviceProtocol.ModbusTcp;
        public string TagId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int Address { get; set; }
        public bool Writable { get; set; }
        public string Oid { get; set; } = string.Empty;

        public static TagDraft From(
            TagItem tag)
        {
            if (tag.Protocol == DeviceProtocol.ModbusTcp)
            {
                var source =
                    tag.Modbus!;

                return new TagDraft
                {
                    Protocol = DeviceProtocol.ModbusTcp,
                    TagId = source.TagId,
                    Name = source.Name,
                    Address = source.Address,
                    Writable = source.Writable
                };
            }

            var snmp =
                tag.Snmp!;

            return new TagDraft
            {
                Protocol = DeviceProtocol.SnmpV2c,
                TagId = snmp.TagId,
                Name = snmp.Name,
                Oid = snmp.Oid,
                Writable = false
            };
        }
    }

    private sealed record DeviceItem(
        DeviceProtocol Protocol,
        string DeviceId,
        string Name,
        bool Enabled,
        string Host,
        int Port,
        IReadOnlyList<TagItem> Tags,
        ModbusDeviceConfigurationDto? Modbus,
        SnmpDeviceConfigurationDto? Snmp)
    {
        public string ProtocolLabel =>
            Protocol == DeviceProtocol.ModbusTcp
                ? "Modbus TCP"
                : "SNMP v2c";

        public string ProtocolShortLabel =>
            Protocol == DeviceProtocol.ModbusTcp
                ? "MODBUS"
                : "SNMP";

        public static DeviceItem From(
            ModbusDeviceConfigurationDto device)
        {
            return new DeviceItem(
                DeviceProtocol.ModbusTcp,
                device.DeviceId,
                device.Name,
                device.Enabled,
                device.Host,
                device.Port,
                device.Tags
                    .Select(tag =>
                        TagItem.From(tag))
                    .ToArray(),
                device,
                Snmp: null);
        }

        public static DeviceItem From(
            SnmpDeviceConfigurationDto device)
        {
            return new DeviceItem(
                DeviceProtocol.SnmpV2c,
                device.DeviceId,
                device.Name,
                device.Enabled,
                device.Host,
                device.Port,
                device.Tags
                    .Select(tag =>
                        TagItem.From(tag))
                    .ToArray(),
                Modbus: null,
                Snmp: device);
        }
    }

    private sealed record TagItem(
        DeviceProtocol Protocol,
        string TagId,
        string Name,
        string TypeLabel,
        string AddressLabel,
        bool Writable,
        ModbusTagConfigurationDto? Modbus,
        SnmpTagConfigurationDto? Snmp)
    {
        public static TagItem From(
            ModbusTagConfigurationDto tag)
        {
            return new TagItem(
                DeviceProtocol.ModbusTcp,
                tag.TagId,
                tag.Name,
                "HR UInt16",
                tag.Address.ToString(),
                tag.Writable,
                tag,
                Snmp: null);
        }

        public static TagItem From(
            SnmpTagConfigurationDto tag)
        {
            return new TagItem(
                DeviceProtocol.SnmpV2c,
                tag.TagId,
                tag.Name,
                "SNMP value",
                tag.Oid,
                Writable: false,
                Modbus: null,
                Snmp: tag);
        }
    }
}
