@page "/mimics/editor"
@inject MimicClient MimicApi
@inject ConfigurationClient Configuration
@inject IJSRuntime JavaScript

<PageTitle>Dispatcher — Редактор мнемосхем</PageTitle>

<div class="mimic-editor-shell">
    <aside class="mimic-editor-navigation">
        <div class="mimic-editor-panel-heading">
            <span>Мнемосхемы</span>
            <span class="item-count">@_mimics.Count</span>
        </div>

        <div class="mimic-editor-list">
            @if (_loading)
            {
                <div class="compact-empty">Загрузка…</div>
            }
            else if (_mimics.Count == 0)
            {
                <div class="compact-empty">
                    Мнемосхем пока нет.
                </div>
            }
            else
            {
                @foreach (var mimic in _mimics)
                {
                    <button type="button"
                            class="mimic-editor-list-item @MimicSelectionClass(mimic)"
                            @onclick="() => SelectMimicAsync(mimic.MimicId)">
                        <span class="mimic-editor-list-name">@mimic.Name</span>
                        <span class="mimic-editor-list-meta">
                            @mimic.MimicId · @mimic.ElementCount элементов
                        </span>
                    </button>
                }
            }
        </div>
    </aside>

    <main class="mimic-editor-workspace">
        <div class="mimic-editor-toolbar">
            <div class="mimic-editor-toolbar-left">
                <button type="button"
                        class="toolbar-button"
                        disabled="@_busy"
                        @onclick="CreateMimicAsync">
                    + Схема
                </button>

                <span class="mimic-editor-toolbar-divider"></span>

                <button type="button"
                        class="toolbar-button"
                        disabled="@(!HasDraft || _busy)"
                        @onclick="() => AddElement(MimicElementTypeDto.Text)">
                    Text
                </button>

                <button type="button"
                        class="toolbar-button"
                        disabled="@(!HasDraft || _busy)"
                        @onclick="() => AddElement(MimicElementTypeDto.Rectangle)">
                    Rectangle
                </button>

                <button type="button"
                        class="toolbar-button"
                        disabled="@(!HasDraft || _busy)"
                        @onclick="() => AddElement(MimicElementTypeDto.Value)">
                    Value
                </button>

                <button type="button"
                        class="toolbar-button"
                        disabled="@(!HasDraft || _busy)"
                        @onclick="() => AddElement(MimicElementTypeDto.Indicator)">
                    Indicator
                </button>

                <button type="button"
                        class="toolbar-button"
                        disabled="@(!HasDraft || _busy)"
                        @onclick="() => AddElement(MimicElementTypeDto.Button)">
                    Button
                </button>

                <span class="mimic-editor-toolbar-divider"></span>

                <button type="button"
                        class="toolbar-button primary"
                        disabled="@(!HasDraft || _busy)"
                        @onclick="SaveAsync">
                    @(_busy ? "Сохранение…" : "Сохранить")
                </button>

                <button type="button"
                        class="toolbar-button danger"
                        disabled="@(!HasDraft || _busy)"
                        @onclick="DeleteAsync">
                    @(_isNewMimic ? "Отменить" : "Удалить схему")
                </button>

                <button type="button"
                        class="toolbar-button danger"
                        disabled="@(SelectedElement is null || _busy)"
                        @onclick="DeleteSelectedElement">
                    Удалить элемент
                </button>
            </div>

            <div class="mimic-editor-toolbar-right">
                @if (_dirty)
                {
                    <span class="unsaved-indicator">
                        несохранено
                    </span>
                }

                <a class="toolbar-button mimic-editor-link"
                   href="/mimics">
                    Runtime
                </a>

                <button type="button"
                        class="toolbar-button"
                        disabled="@_busy"
                        @onclick="RefreshAsync">
                    Обновить
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="editor-error">
                @_error
            </div>
        }

        <div class="mimic-editor-work-content">
            @if (_draft is null)
            {
                <div class="mimic-editor-empty">
                    <div class="mimic-editor-empty-title">
                        Выберите или создайте мнемосхему
                    </div>
                    <div class="mimic-editor-empty-text">
                        Элементы добавляются через toolbar.
                        Координаты, размеры и binding редактируются справа.
                    </div>
                </div>
            }
            else
            {
                <div class="mimic-editor-canvas-wrap">
                    <svg class="mimic-editor-canvas"
                         viewBox="0 0 @_draft.Width @_draft.Height"
                         preserveAspectRatio="xMidYMid meet"
                         aria-label="@_draft.Name">
                        <rect x="0"
                              y="0"
                              width="@_draft.Width"
                              height="@_draft.Height"
                              class="mimic-editor-canvas-background"
                              @onclick="SelectMimicProperties" />

                        @foreach (var element in _draft.Elements)
                        {
                            <g class="mimic-editor-element @ElementSelectionClass(element)"
                               @onclick="() => SelectElement(element)">
                                @switch (element.Type)
                                {
                                    case MimicElementTypeDto.Text:
                                        <rect x="@element.X"
                                              y="@element.Y"
                                              width="@element.Width"
                                              height="@element.Height"
                                              class="mimic-editor-text-hit-area" />
                                        <foreignObject x="@element.X"
                                                       y="@element.Y"
                                                       width="@element.Width"
                                                       height="@element.Height"
                                                       class="mimic-editor-foreign">
                                            <div class="mimic-editor-preview-text">
                                                @PreviewText(element)
                                            </div>
                                        </foreignObject>
                                        break;

                                    case MimicElementTypeDto.Rectangle:
                                        <rect x="@element.X"
                                              y="@element.Y"
                                              width="@element.Width"
                                              height="@element.Height"
                                              class="mimic-editor-preview-rectangle" />
                                        break;

                                    case MimicElementTypeDto.Value:
                                        <rect x="@element.X"
                                              y="@element.Y"
                                              width="@element.Width"
                                              height="@element.Height"
                                              rx="3"
                                              class="mimic-editor-preview-box" />
                                        <foreignObject x="@element.X"
                                                       y="@element.Y"
                                                       width="@element.Width"
                                                       height="@element.Height"
                                                       class="mimic-editor-foreign">
                                            <div class="mimic-editor-preview-content">
                                                <div class="mimic-editor-preview-label">
                                                    @PreviewText(element)
                                                </div>
                                                <div class="mimic-editor-preview-value">
                                                    @PreviewBinding(element)
                                                </div>
                                            </div>
                                        </foreignObject>
                                        break;

                                    case MimicElementTypeDto.Indicator:
                                        <rect x="@element.X"
                                              y="@element.Y"
                                              width="@element.Width"
                                              height="@element.Height"
                                              rx="3"
                                              class="mimic-editor-preview-box" />
                                        <circle cx="@(element.X + 16)"
                                                cy="@(element.Y + element.Height / 2)"
                                                r="7"
                                                class="mimic-editor-preview-indicator" />
                                        <foreignObject x="@(element.X + 28)"
                                                       y="@element.Y"
                                                       width="@Math.Max(1, element.Width - 28)"
                                                       height="@element.Height"
                                                       class="mimic-editor-foreign">
                                            <div class="mimic-editor-preview-content">
                                                <div class="mimic-editor-preview-label">
                                                    @PreviewText(element)
                                                </div>
                                                <div class="mimic-editor-preview-small">
                                                    @PreviewBinding(element)
                                                </div>
                                            </div>
                                        </foreignObject>
                                        break;

                                    case MimicElementTypeDto.Button:
                                        <rect x="@element.X"
                                              y="@element.Y"
                                              width="@element.Width"
                                              height="@element.Height"
                                              rx="4"
                                              class="mimic-editor-preview-button" />
                                        <foreignObject x="@element.X"
                                                       y="@element.Y"
                                                       width="@element.Width"
                                                       height="@element.Height"
                                                       class="mimic-editor-foreign">
                                            <div class="mimic-editor-preview-button-text">
                                                @PreviewText(element)
                                            </div>
                                        </foreignObject>
                                        break;
                                }

                                @if (IsSelected(element))
                                {
                                    <rect x="@element.X"
                                          y="@element.Y"
                                          width="@element.Width"
                                          height="@element.Height"
                                          class="mimic-editor-selection" />
                                }
                            </g>
                        }
                    </svg>
                </div>
            }
        </div>
    </main>

    <aside class="mimic-editor-properties">
        <div class="mimic-editor-panel-heading">
            @PropertiesHeading
        </div>

        @if (_draft is null)
        {
            <div class="mimic-editor-properties-empty">
                Выберите мнемосхему.
            </div>
        }
        else if (SelectedElement is null)
        {
            <div class="property-form">
                <label class="property-field">
                    <span>Mimic ID</span>
                    <input type="text"
                           disabled="@(!_isNewMimic)"
                           @bind="_draft.MimicId"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>

                @if (!_isNewMimic)
                {
                    <div class="property-inline-note">
                        ID существующей схемы не переименовывается.
                    </div>
                }

                <label class="property-field">
                    <span>Имя</span>
                    <input type="text"
                           @bind="_draft.Name"
                           @bind:event="oninput"
                           @bind:after="MarkDirty" />
                </label>

                <div class="property-section-title">
                    Canvas
                </div>

                <div class="property-grid-two">
                    <label class="property-field">
                        <span>Width</span>
                        <input type="number"
                               min="1"
                               max="10000"
                               @bind="_draft.Width"
                               @bind:after="MarkDirty" />
                    </label>

                    <label class="property-field">
                        <span>Height</span>
                        <input type="number"
                               min="1"
                               max="10000"
                               @bind="_draft.Height"
                               @bind:after="MarkDirty" />
                    </label>
                </div>

                <div class="property-help">
                    Клик по свободной области canvas возвращает свойства схемы.
                </div>
            </div>
        }
        else
        {
            var element = SelectedElement!;

            <div class="property-form">
                <label class="property-field">
                    <span>Element ID</span>
                    <input type="text"
                           value="@element.ElementId"
                           disabled />
                </label>

                <div class="property-inline-note">
                    Technical ID генерируется автоматически.
                </div>

                <label class="property-field">
                    <span>Type</span>
                    <select @bind="element.Type"
                            @bind:after="OnElementTypeChanged">
                        <option value="Text">Text</option>
                        <option value="Rectangle">Rectangle</option>
                        <option value="Value">Value</option>
                        <option value="Indicator">Indicator</option>
                        <option value="Button">Button</option>
                    </select>
                </label>

                <div class="property-section-title">
                    Position / size
                </div>

                <div class="property-grid-two">
                    <label class="property-field">
                        <span>X</span>
                        <input type="number"
                               min="0"
                               @bind="element.X"
                               @bind:after="MarkDirty" />
                    </label>

                    <label class="property-field">
                        <span>Y</span>
                        <input type="number"
                               min="0"
                               @bind="element.Y"
                               @bind:after="MarkDirty" />
                    </label>

                    <label class="property-field">
                        <span>Width</span>
                        <input type="number"
                               min="1"
                               @bind="element.Width"
                               @bind:after="MarkDirty" />
                    </label>

                    <label class="property-field">
                        <span>Height</span>
                        <input type="number"
                               min="1"
                               @bind="element.Height"
                               @bind:after="MarkDirty" />
                    </label>
                </div>

                @if (element.Type != MimicElementTypeDto.Rectangle)
                {
                    <div class="property-section-title">
                        Content
                    </div>

                    <label class="property-field">
                        <span>Text</span>
                        <input type="text"
                               @bind="element.Text"
                               @bind:event="oninput"
                               @bind:after="MarkDirty" />
                    </label>
                }

                @if (RequiresTag(element.Type))
                {
                    <label class="property-field">
                        <span>Tag ID</span>
                        <select @bind="element.TagId"
                                @bind:after="MarkDirty">
                            <option value="">— выбрать тег —</option>

                            @foreach (var tagId in TagOptions(element.TagId))
                            {
                                <option value="@tagId">@tagId</option>
                            }
                        </select>
                    </label>

                    @if (_configuredTagIds.Count == 0)
                    {
                        <div class="property-inline-note">
                            В device configuration пока нет тегов.
                        </div>
                    }
                }

                @if (element.Type == MimicElementTypeDto.Button)
                {
                    <label class="property-field">
                        <span>Command value</span>
                        <input type="number"
                               min="0"
                               max="65535"
                               @bind="element.CommandValue"
                               @bind:after="MarkDirty" />
                    </label>

                    <div class="property-help">
                        Runtime Button использует существующий tag write path.
                        Значение ограничено UInt16.
                    </div>
                }
                else if (element.Type is MimicElementTypeDto.Value
                         or MimicElementTypeDto.Indicator)
                {
                    <div class="property-help">
                        Binding хранит только logical TagId.
                        Protocol address/OID в мнемосхему не попадает.
                    </div>
                }
            </div>
        }
    </aside>
</div>

@code {
    private IReadOnlyList<MimicSummaryDto> _mimics =
        Array.Empty<MimicSummaryDto>();

    private readonly List<string> _configuredTagIds = [];

    private MimicDraft? _draft;
    private string? _selectedElementId;
    private bool _isNewMimic;
    private bool _dirty;
    private bool _loading;
    private bool _busy;
    private string? _error;

    private bool HasDraft =>
        _draft is not null;

    private MimicElementDraft? SelectedElement =>
        _draft?.Elements.FirstOrDefault(element =>
            string.Equals(
                element.ElementId,
                _selectedElementId,
                StringComparison.Ordinal));

    private string PropertiesHeading =>
        SelectedElement is null
            ? "Свойства схемы"
            : "Свойства элемента";

    protected override async Task OnInitializedAsync()
    {
        await LoadTagOptionsAsync();
        await ReloadListAsync();
    }

    private async Task LoadTagOptionsAsync()
    {
        try
        {
            var modbus =
                await Configuration.GetDevicesAsync();

            var snmp =
                await Configuration.GetSnmpDevicesAsync();

            _configuredTagIds.Clear();

            _configuredTagIds.AddRange(
                modbus
                    .SelectMany(device => device.Tags)
                    .Select(tag => tag.TagId)
                    .Concat(
                        snmp
                            .SelectMany(device => device.Tags)
                            .Select(tag => tag.TagId))
                    .Distinct(StringComparer.Ordinal)
                    .OrderBy(
                        tagId => tagId,
                        StringComparer.Ordinal));
        }
        catch (Exception exception)
        {
            _error =
                $"Не удалось загрузить список тегов: {exception.Message}";
        }
    }

    private async Task ReloadListAsync(
        string? preferredMimicId = null)
    {
        _loading = true;

        try
        {
            _mimics =
                await MimicApi.GetAllAsync();

            if (preferredMimicId is null)
            {
                return;
            }

            var exists =
                _mimics.Any(mimic =>
                    string.Equals(
                        mimic.MimicId,
                        preferredMimicId,
                        StringComparison.Ordinal));

            if (!exists)
            {
                ClearDraft();
            }
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateMimicAsync()
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }

        _draft =
            new MimicDraft
            {
                MimicId = CreateUniqueMimicId(),
                Name = "Новая мнемосхема",
                Width = 800,
                Height = 450
            };

        _selectedElementId = null;
        _isNewMimic = true;
        _dirty = true;
        _error = null;
    }

    private async Task SelectMimicAsync(
        string mimicId)
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var definition =
                await MimicApi.GetAsync(
                    mimicId);

            if (definition is null)
            {
                _error =
                    $"Мнемосхема '{mimicId}' не найдена.";

                await ReloadListAsync();
                return;
            }

            _draft =
                MimicDraft.From(
                    definition);

            _selectedElementId = null;
            _isNewMimic = false;
            _dirty = false;
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }

        var selectedId =
            _draft?.MimicId;
        var wasNew =
            _isNewMimic;

        _dirty = false;

        if (wasNew)
        {
            ClearDraft();
        }

        await LoadTagOptionsAsync();
        await ReloadListAsync(
            wasNew
                ? null
                : selectedId);

        if (selectedId is not null
            && !wasNew)
        {
            await SelectMimicAsync(
                selectedId);
        }
    }

    private void AddElement(
        MimicElementTypeDto type)
    {
        if (_draft is null)
        {
            return;
        }

        var index =
            _draft.Elements.Count;

        var element =
            MimicElementDraft.Create(
                CreateUniqueElementId(type),
                type,
                30 + (index * 12) % 180,
                30 + (index * 12) % 120,
                _configuredTagIds.FirstOrDefault());

        _draft.Elements.Add(
            element);

        _selectedElementId =
            element.ElementId;

        MarkDirty();
    }

    private void SelectElement(
        MimicElementDraft element)
    {
        _selectedElementId =
            element.ElementId;
    }

    private void SelectMimicProperties()
    {
        _selectedElementId = null;
    }

    private void DeleteSelectedElement()
    {
        if (_draft is null
            || _selectedElementId is null)
        {
            return;
        }

        var removed =
            _draft.Elements.RemoveAll(element =>
                string.Equals(
                    element.ElementId,
                    _selectedElementId,
                    StringComparison.Ordinal));

        if (removed > 0)
        {
            _selectedElementId = null;
            MarkDirty();
        }
    }

    private async Task SaveAsync()
    {
        if (_draft is null
            || _busy)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var definition =
                BuildDefinition(
                    _draft);

            var saved =
                await MimicApi.SaveAsync(
                    definition);

            _draft =
                MimicDraft.From(
                    saved);

            _selectedElementId = null;
            _isNewMimic = false;
            _dirty = false;

            await ReloadListAsync(
                saved.MimicId);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_draft is null)
        {
            return;
        }

        if (_isNewMimic)
        {
            ClearDraft();
            return;
        }

        var confirmed =
            await JavaScript.InvokeAsync<bool>(
                "confirm",
                $"Удалить мнемосхему '{_draft.Name}'?");

        if (!confirmed)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            await MimicApi.DeleteAsync(
                _draft.MimicId);

            ClearDraft();
            await ReloadListAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnElementTypeChanged()
    {
        var element =
            SelectedElement;

        if (element is null)
        {
            return;
        }

        switch (element.Type)
        {
            case MimicElementTypeDto.Text:
                element.TagId = null;
                element.CommandValue = null;
                element.Text =
                    string.IsNullOrWhiteSpace(element.Text)
                        ? "Text"
                        : element.Text;
                break;

            case MimicElementTypeDto.Rectangle:
                element.Text = null;
                element.TagId = null;
                element.CommandValue = null;
                break;

            case MimicElementTypeDto.Value:
            case MimicElementTypeDto.Indicator:
                element.TagId ??=
                    _configuredTagIds.FirstOrDefault();
                element.CommandValue = null;
                break;

            case MimicElementTypeDto.Button:
                element.TagId ??=
                    _configuredTagIds.FirstOrDefault();
                element.CommandValue ??= 1;
                element.Text =
                    string.IsNullOrWhiteSpace(element.Text)
                        ? "Команда"
                        : element.Text;
                break;
        }

        MarkDirty();
    }

    private MimicDefinitionDto BuildDefinition(
        MimicDraft draft)
    {
        if (string.IsNullOrWhiteSpace(
                draft.MimicId))
        {
            throw new InvalidOperationException(
                "Mimic ID обязателен.");
        }

        if (string.IsNullOrWhiteSpace(
                draft.Name))
        {
            throw new InvalidOperationException(
                "Имя мнемосхемы обязательно.");
        }

        var duplicateElement =
            draft.Elements
                .GroupBy(
                    element => element.ElementId,
                    StringComparer.Ordinal)
                .FirstOrDefault(group =>
                    string.IsNullOrWhiteSpace(group.Key)
                    || group.Count() > 1);

        if (duplicateElement is not null)
        {
            throw new InvalidOperationException(
                "Element ID должен быть заполнен и уникален.");
        }

        var elements =
            draft.Elements
                .Select(element =>
                    element.ToDto())
                .ToArray();

        return new MimicDefinitionDto(
            draft.MimicId.Trim(),
            draft.Name.Trim(),
            draft.Width,
            draft.Height,
            elements);
    }

    private IEnumerable<string> TagOptions(
        string? currentTagId)
    {
        if (!string.IsNullOrWhiteSpace(
                currentTagId)
            && !_configuredTagIds.Contains(
                currentTagId,
                StringComparer.Ordinal))
        {
            yield return currentTagId;
        }

        foreach (var tagId in _configuredTagIds)
        {
            yield return tagId;
        }
    }

    private string CreateUniqueMimicId()
    {
        for (var index = 1;
             index < 10000;
             index++)
        {
            var candidate =
                $"mimic{index:00}";

            if (!_mimics.Any(mimic =>
                    string.Equals(
                        mimic.MimicId,
                        candidate,
                        StringComparison.Ordinal)))
            {
                return candidate;
            }
        }

        return $"mimic-{Guid.NewGuid():N}";
    }

    private string CreateUniqueElementId(
        MimicElementTypeDto type)
    {
        var prefix =
            type.ToString()
                .ToLowerInvariant();

        for (var index = 1;
             index < 10000;
             index++)
        {
            var candidate =
                $"{prefix}{index:00}";

            if (_draft is null
                || !_draft.Elements.Any(element =>
                    string.Equals(
                        element.ElementId,
                        candidate,
                        StringComparison.Ordinal)))
            {
                return candidate;
            }
        }

        return $"{prefix}-{Guid.NewGuid():N}";
    }

    private async Task<bool> ConfirmDiscardAsync()
    {
        if (!_dirty)
        {
            return true;
        }

        return await JavaScript.InvokeAsync<bool>(
            "confirm",
            "Есть несохранённые изменения. Отбросить их?");
    }

    private void MarkDirty()
    {
        _dirty = true;
        _error = null;
    }

    private void ClearDraft()
    {
        _draft = null;
        _selectedElementId = null;
        _isNewMimic = false;
        _dirty = false;
        _error = null;
    }

    private bool IsSelected(
        MimicElementDraft element)
    {
        return string.Equals(
            element.ElementId,
            _selectedElementId,
            StringComparison.Ordinal);
    }

    private string ElementSelectionClass(
        MimicElementDraft element)
    {
        return IsSelected(element)
            ? "selected"
            : string.Empty;
    }

    private string MimicSelectionClass(
        MimicSummaryDto mimic)
    {
        return !_isNewMimic
               && string.Equals(
                   mimic.MimicId,
                   _draft?.MimicId,
                   StringComparison.Ordinal)
            ? "selected"
            : string.Empty;
    }

    private static bool RequiresTag(
        MimicElementTypeDto type)
    {
        return type is
            MimicElementTypeDto.Value
            or MimicElementTypeDto.Indicator
            or MimicElementTypeDto.Button;
    }

    private static string PreviewText(
        MimicElementDraft element)
    {
        if (!string.IsNullOrWhiteSpace(
                element.Text))
        {
            return element.Text;
        }

        return element.Type switch
        {
            MimicElementTypeDto.Text => "Text",
            MimicElementTypeDto.Value => "Value",
            MimicElementTypeDto.Indicator => "Indicator",
            MimicElementTypeDto.Button => "Button",
            _ => string.Empty
        };
    }

    private static string PreviewBinding(
        MimicElementDraft element)
    {
        return string.IsNullOrWhiteSpace(
                element.TagId)
            ? "TagId не выбран"
            : element.TagId;
    }

    private sealed class MimicDraft
    {
        public string MimicId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int Width { get; set; } = 800;
        public int Height { get; set; } = 450;
        public List<MimicElementDraft> Elements { get; } = [];

        public static MimicDraft From(
            MimicDefinitionDto definition)
        {
            var draft =
                new MimicDraft
                {
                    MimicId = definition.MimicId,
                    Name = definition.Name,
                    Width = definition.Width,
                    Height = definition.Height
                };

            draft.Elements.AddRange(
                definition.Elements.Select(
                    MimicElementDraft.From));

            return draft;
        }
    }

    private sealed class MimicElementDraft
    {
        public string ElementId { get; set; } = string.Empty;
        public MimicElementTypeDto Type { get; set; }
        public int X { get; set; }
        public int Y { get; set; }
        public int Width { get; set; }
        public int Height { get; set; }
        public string? Text { get; set; }
        public string? TagId { get; set; }
        public int? CommandValue { get; set; }

        public MimicElementDto ToDto()
        {
            ushort? commandValue = null;

            if (Type == MimicElementTypeDto.Button)
            {
                if (CommandValue is null
                    || CommandValue is < 0 or > ushort.MaxValue)
                {
                    throw new InvalidOperationException(
                        $"Button '{ElementId}' Command value должен быть от 0 до 65535.");
                }

                commandValue =
                    (ushort)CommandValue.Value;
            }

            return new MimicElementDto(
                ElementId,
                Type,
                X,
                Y,
                Width,
                Height,
                Text,
                RequiresTag(Type)
                    ? TagId
                    : null,
                commandValue);
        }

        public static MimicElementDraft From(
            MimicElementDto element)
        {
            return new MimicElementDraft
            {
                ElementId = element.ElementId,
                Type = element.Type,
                X = element.X,
                Y = element.Y,
                Width = element.Width,
                Height = element.Height,
                Text = element.Text,
                TagId = element.TagId,
                CommandValue = element.CommandValue
            };
        }

        public static MimicElementDraft Create(
            string elementId,
            MimicElementTypeDto type,
            int x,
            int y,
            string? defaultTagId)
        {
            return type switch
            {
                MimicElementTypeDto.Text =>
                    new MimicElementDraft
                    {
                        ElementId = elementId,
                        Type = type,
                        X = x,
                        Y = y,
                        Width = 180,
                        Height = 34,
                        Text = "Text"
                    },

                MimicElementTypeDto.Rectangle =>
                    new MimicElementDraft
                    {
                        ElementId = elementId,
                        Type = type,
                        X = x,
                        Y = y,
                        Width = 220,
                        Height = 120
                    },

                MimicElementTypeDto.Value =>
                    new MimicElementDraft
                    {
                        ElementId = elementId,
                        Type = type,
                        X = x,
                        Y = y,
                        Width = 180,
                        Height = 60,
                        Text = "Value",
                        TagId = defaultTagId
                    },

                MimicElementTypeDto.Indicator =>
                    new MimicElementDraft
                    {
                        ElementId = elementId,
                        Type = type,
                        X = x,
                        Y = y,
                        Width = 180,
                        Height = 54,
                        Text = "Indicator",
                        TagId = defaultTagId
                    },

                MimicElementTypeDto.Button =>
                    new MimicElementDraft
                    {
                        ElementId = elementId,
                        Type = type,
                        X = x,
                        Y = y,
                        Width = 120,
                        Height = 44,
                        Text = "Команда",
                        TagId = defaultTagId,
                        CommandValue = 1
                    },

                _ =>
                    throw new ArgumentOutOfRangeException(
                        nameof(type),
                        type,
                        null)
            };
        }
    }
}
