@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationClient Authentication
@inject NavigationManager NavigationManager

<div class="application-shell">
    <header class="global-header">
        <button class="menu-button"
                type="button"
                aria-label="Открыть глобальную навигацию"
                @onclick="ToggleGlobalNavigation">
            <span aria-hidden="true">☰</span>
        </button>

        <div class="brand">Dispatcher</div>
        <div class="global-section">@CurrentSection</div>

        <div class="global-header-spacer"></div>

        @if (!string.IsNullOrWhiteSpace(
                Authentication.LastError))
        {
            <div class="global-auth-error"
                 title="@Authentication.LastError">
                @Authentication.LastError
            </div>
        }

        <div class="global-user"
             title="@Authentication.CurrentUser.UserName">
            <span class="global-user-display-name">
                @Authentication.CurrentUser.DisplayName
            </span>
            <span class="global-user-name">
                @Authentication.CurrentUser.UserName
            </span>
        </div>

        <button class="header-action-button"
                type="button"
                disabled="@_logoutBusy"
                @onclick="LogoutAsync">
            @(_logoutBusy ? "Выход…" : "Выйти")
        </button>
    </header>

    @if (_globalNavigationOpen)
    {
        <div class="global-nav-backdrop"
             @onclick="CloseGlobalNavigation">
            <nav class="global-nav-drawer"
                 aria-label="Глобальная навигация"
                 @onclick:stopPropagation="true">
                <div class="global-nav-title">Сервисы</div>

                @if (CanReadRuntime)
                {
                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href=""
                             Match="NavLinkMatch.All"
                             @onclick="CloseGlobalNavigation">
                        Мониторинг
                    </NavLink>
                }

                @if (CanEditDevices)
                {
                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="devices"
                             @onclick="CloseGlobalNavigation">
                        Редактор устройств
                    </NavLink>
                }

                @if (CanReadRuntime)
                {
                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="mimics"
                             @onclick="CloseGlobalNavigation">
                        Мнемосхемы
                    </NavLink>

                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="history"
                             @onclick="CloseGlobalNavigation">
                        История / Тренды
                    </NavLink>

                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="events"
                             @onclick="CloseGlobalNavigation">
                        События
                    </NavLink>
                }

                @if (CanEditTemplates)
                {
                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="mimics/templates"
                             @onclick="CloseGlobalNavigation">
                        Шаблоны мнемосхем
                    </NavLink>
                }

                @if (CanReadRuntime)
                {
                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="alarms"
                             Match="NavLinkMatch.All"
                             @onclick="CloseGlobalNavigation">
                        Тревоги
                    </NavLink>
                }

                @if (CanEditAlarms)
                {
                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="alarms/editor"
                             @onclick="CloseGlobalNavigation">
                        Редактор тревог
                    </NavLink>
                }

                @if (CanManageSecurity)
                {
                    <NavLink class="global-nav-link"
                             ActiveClass="active"
                             href="security"
                             @onclick="CloseGlobalNavigation">
                        Пользователи / Роли
                    </NavLink>
                }

                @if (!CanReadRuntime && !CanManageSecurity)
                {
                    <div class="compact-empty">
                        Нет доступных сервисов.
                    </div>
                }
            </nav>
        </div>
    }

    <div class="application-content">
        @Body
    </div>
</div>

@code {
    private bool _globalNavigationOpen;
    private bool _logoutBusy;

    private bool CanReadRuntime =>
        Authentication.HasPermission(
            PermissionNames.RuntimeRead);

    private bool CanEditDevices =>
        Authentication.HasAllPermissions(
            PermissionNames.RuntimeRead,
            PermissionNames.DevicesEdit);

    private bool CanEditTemplates =>
        Authentication.HasAllPermissions(
            PermissionNames.RuntimeRead,
            PermissionNames.TemplatesEdit);

    private bool CanEditAlarms =>
        Authentication.HasAllPermissions(
            PermissionNames.RuntimeRead,
            PermissionNames.AlarmsConfigure);

    private bool CanManageSecurity =>
        Authentication.HasPermission(
            PermissionNames.UsersManage)
        || Authentication.HasPermission(
            PermissionNames.RolesManage);

    private string CurrentSection
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(
                NavigationManager.Uri);

            if (path.StartsWith(
                    "devices",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "Редактор устройств";
            }

            if (path.StartsWith(
                    "mimics/templates",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "Шаблоны мнемосхем";
            }

            if (path.StartsWith(
                    "mimics",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "Мнемосхемы";
            }

            if (path.StartsWith(
                    "history",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "История / Тренды";
            }

            if (path.StartsWith(
                    "events",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "События";
            }

            if (path.StartsWith(
                    "alarms/editor",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "Редактор тревог";
            }

            if (path.StartsWith(
                    "alarms",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "Тревоги";
            }

            if (path.StartsWith(
                    "security",
                    StringComparison.OrdinalIgnoreCase))
            {
                return "Пользователи / Роли";
            }

            return "Мониторинг";
        }
    }

    protected override void OnInitialized()
    {
        Authentication.Changed += OnAuthenticationChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void ToggleGlobalNavigation()
    {
        _globalNavigationOpen = !_globalNavigationOpen;
    }

    private void CloseGlobalNavigation()
    {
        _globalNavigationOpen = false;
    }

    private async Task LogoutAsync()
    {
        if (_logoutBusy)
        {
            return;
        }

        _logoutBusy =
            true;
        _globalNavigationOpen =
            false;

        try
        {
            await Authentication.LogoutAsync();
        }
        finally
        {
            _logoutBusy =
                false;
        }
    }

    private void OnAuthenticationChanged()
    {
        _globalNavigationOpen =
            false;

        _ = InvokeAsync(
            StateHasChanged);
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        _globalNavigationOpen =
            false;

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Authentication.Changed -= OnAuthenticationChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
